{
  "info": {
    "_postman_id": "a7f3c8e1-2d4b-4b9a-9f11-8c3e1a000001",
    "name": "Awgment Account API v2 (Phase 1)",
    "description": "Postman Collection v2.1 for Awgment Headless Multi-Tenant IAM Service (/accounts/v2). Currently covers Phase 0 (Actuator Probes) and Phase 1 (UC-TENANT-01..04, UC-AUTH-01). Import companion environment docs/postman/awgment-local.postman_environment.json and populate local dev secrets before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "keycloakUrl", "value": "http://localhost:8080" },
    { "key": "platformRealm", "value": "platform" },
    { "key": "tenantRealm", "value": "acme" },
    { "key": "tenantId", "value": "acme" },
    { "key": "tenantVersion", "value": "0" }
  ],
  "item": [
    {
      "name": "00 - Auth (Keycloak 26 Token Helpers)",
      "description": "Local development helpers to obtain short-lived JWTs from Keycloak 26 realms. Populate secret variables in your Postman Environment (never commit secrets).",
      "item": [
        {
          "name": "Get Platform Admin Token (platform realm)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Access token returned', function () {",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('platformToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{platformClientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{platformClientSecret}}", "type": "text" },
                { "key": "username", "value": "{{platformAdminUsername}}", "type": "text" },
                { "key": "password", "value": "{{platformAdminPassword}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{platformRealm}}/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms", "{{platformRealm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Fetches a Tier 0 awgment-platform-admin JWT from the dedicated Platform Control Realm and stores it in {{platformToken}}."
          },
          "response": []
        },
        {
          "name": "Get Tenant User Token (acme realm)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Access token returned', function () {",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('accessToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{tenantClientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{tenantClientSecret}}", "type": "text" },
                { "key": "username", "value": "{{tenantUsername}}", "type": "text" },
                { "key": "password", "value": "{{tenantUserPassword}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{tenantRealm}}/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms", "{{tenantRealm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Fetches a tenant-scoped JWT from {{tenantRealm}} and stores it in {{accessToken}}."
          },
          "response": []
        }
      ]
    },
    {

# Local Docker environment configuration for awgment-app-account (v2 / Java 21 / PostgreSQL 16)
# Override secrets via secret manager or Kubernetes Secret in non-local deployments.

SERVER_PORT=8081
# Optional deterministic Snowflake node ID (0..1023) for multi-replica deployments; -1 auto-derives from NIC MAC
AWGMENT_NODE_ID=-1

# PostgreSQL 16 (Spring Data JPA & Flyway)
AWGMENT_DB_URL=jdbc:postgresql://postgres:5432/awgment_account
AWGMENT_DB_USERNAME=awgment
AWGMENT_DB_PASSWORD=awgment_local_dev_password
AWGMENT_DB_POOL_MAX=20
AWGMENT_DB_POOL_MIN_IDLE=5
AWGMENT_DB_CONN_TIMEOUT_MS=9500
AWGMENT_DB_LEAK_THRESHOLD_MS=0
AWGMENT_FLYWAY_ENABLED=true

# Keycloak 26 & Security Contract
AWGMENT_KEYCLOAK_URL=http://keycloak:8080
AWGMENT_PLATFORM_REALM=platform
AWGMENT_EXPECTED_AUDIENCE=awgment-account
AWGMENT_TRUSTED_CLIENT_ID=awgment-account

# OpenAPI / Swagger UI (strictly disabled by default; enable only in local dev)
AWGMENT_OPENAPI_ENABLED=false

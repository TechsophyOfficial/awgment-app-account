# Local Docker environment configuration for awgment-app-account (v2 / Java 21 / PostgreSQL 16)
# Override secrets via secret manager or Kubernetes Secret in non-local deployments.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081
# Optional deterministic Snowflake node ID (0..1023) for multi-replica deployments; -1 auto-derives from NIC MAC
AWGMENT_NODE_ID=-1

# PostgreSQL 16 (Spring Data JPA & Flyway)
AWGMENT_DB_URL=jdbc:postgresql://postgres:5432/awgment_account
AWGMENT_DB_USERNAME=awgment
AWGMENT_DB_PASSWORD=awgment_local_dev_password
AWGMENT_DB_POOL_MAX=20
AWGMENT_DB_POOL_MIN_IDLE=5
AWGMENT_DB_CONN_TIMEOUT_MS=9500
AWGMENT_DB_LEAK_THRESHOLD_MS=0
AWGMENT_FLYWAY_ENABLED=true
AWGMENT_FLYWAY_MIGRATE_ON_STARTUP=true

# Multi-tenancy & Provisioning Recovery
AWGMENT_MULTITENANCY_ENABLED=true
AWGMENT_TENANT_STATUS_CACHE_TTL_SECONDS=60
AWGMENT_MULTITENANCY_PROVISIONING_STALE_TTL_SECONDS=300

# Keycloak 26 & Security Contract (split external JWT issuer vs internal Docker service DNS)
AWGMENT_KEYCLOAK_URL=http://localhost:8080
AWGMENT_KEYCLOAK_INTERNAL_URL=http://keycloak:8080
AWGMENT_PLATFORM_REALM=platform
AWGMENT_EXPECTED_AUDIENCE=awgment-account
AWGMENT_TRUSTED_CLIENT_ID=awgment-account
AWGMENT_SERVICE_ACCOUNT_CLIENTS=awgment-service-client
AWGMENT_SECURITY_DECODER_CACHE_MAX_SIZE=500
AWGMENT_SECURITY_DECODER_CACHE_TTL_SECONDS=300
AWGMENT_SECURITY_OIDC_CONNECT_TIMEOUT_MS=5000
AWGMENT_SECURITY_OIDC_READ_TIMEOUT_MS=8000

# Keycloak 26 Admin REST Client
AWGMENT_KEYCLOAK_ADMIN_URL=http://keycloak:8080
AWGMENT_KEYCLOAK_ADMIN_REALM=master
AWGMENT_KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
AWGMENT_KEYCLOAK_ADMIN_CLIENT_SECRET=
AWGMENT_KEYCLOAK_ADMIN_USERNAME=admin
AWGMENT_KEYCLOAK_ADMIN_PASSWORD=admin_local_dev_password
AWGMENT_KEYCLOAK_CONNECT_TIMEOUT_MS=5000
AWGMENT_KEYCLOAK_READ_TIMEOUT_MS=8000
AWGMENT_SECURITY_MAX_JSON_BODY_SIZE=256KB

# Coalesced Outbox Worker & Sync Revocation Settings
AWGMENT_OUTBOX_WORKER_ENABLED=true
AWGMENT_OUTBOX_POLL_INTERVAL_MS=2000
AWGMENT_OUTBOX_LEASE_TTL_SECONDS=60
AWGMENT_OUTBOX_VERIFICATION_DELAY_SECONDS=15
AWGMENT_OUTBOX_SYNC_REVOKE_TIMEOUT_MS=5000
AWGMENT_OUTBOX_MAX_RETRIES=5
AWGMENT_OUTBOX_BATCH_SIZE=20
AWGMENT_OUTBOX_BASE_BACKOFF_SECONDS=5
AWGMENT_OUTBOX_MAX_BACKOFF_SECONDS=300
AWGMENT_OUTBOX_ACTION_EMAIL_DELIVERY_ENABLED=false

# OpenAPI / Swagger UI (strictly disabled by default; enable only in local dev)
AWGMENT_OPENAPI_ENABLED=false
